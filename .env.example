# =====================================================================
# Département de Communication — Université de Bouaké
# Variables d'environnement
# =====================================================================

# --- Serveur ---------------------------------------------------------
PORT=3000
NODE_ENV=development
# URL publique de l'application (utile pour Render : https://xxx.onrender.com)
APP_URL=http://localhost:3000

# --- Base de données -------------------------------------------------
# PostgreSQL en production (Render fournit DATABASE_URL).
# En production, l'application REFUSE de démarrer sans DATABASE_URL.
DATABASE_URL=postgresql://user:password@host:5432/basededonnees

# Développement local SANS PostgreSQL : base PostgreSQL embarquée
# (PGlite), persistée dans le dossier indiqué. Uniquement autorisé
# lorsque NODE_ENV n'est pas "production".
PGLITE_DATA_DIR=./storage/pglite

# --- Sécurité --------------------------------------------------------
# Obligatoire en production : longue chaîne aléatoire (32+ caractères).
# Sert à signer / durcir les cookies de session.
SESSION_SECRET=changez-moi-avec-une-longue-chaine-aleatoire

# Durée de vie d'une session (heures)
SESSION_TTL_HOURS=24
# Connexion derrière un proxy (Render) : activer pour les cookies "secure"
TRUST_PROXY=1

# --- Inscription -----------------------------------------------------
# Validation administrative des inscriptions : 1 (activée) ou 0
REQUIRE_APPROVAL=1
# Inscriptions ouvertes : 1 (ouvertes) ou 0 (fermées)
REGISTRATION_OPEN=1

# Rôle attribué aux nouvelles inscriptions. "etudiant" par défaut,
# modifiable dans les paramètres de l'application.
DEFAULT_SIGNUP_ROLE=etudiant

# --- Stockage --------------------------------------------------------
# Mode de stockage des fichiers :
#   auto     = disque local en développement, PostgreSQL en production (recommandé)
#   postgres = fichiers en base PostgreSQL (durable sur Render sans disque)
#   local    = disque local (développement uniquement ; ignoré en production)
#   supabase = Supabase Storage privé (renseigner SUPABASE_URL et SUPABASE_SERVICE_KEY)
# Sur Render, le disque est éphémère : "auto" stocke les fichiers en base.
STORAGE_DRIVER=auto
STORAGE_DIR=./storage
# Limite de taille par fichier (Mo)
MAX_UPLOAD_MB=8

# --- Stockage objet Supabase (optionnel, production durable) ----------
# BACKEND="supabase" pour stocker les fichiers sur un bucket privé.
STORAGE_BACKEND=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents

# --- Admin initial (facultatif) --------------------------------------
# Aucun mot de passe n'est codé en dur. Méthode recommandée :
#   npm run create-admin   (saisie masquée, mode interactif)
# Variante pour le premier démarrage sur Render : définir ADMIN_PHONE et
# ADMIN_PASSWORD (6 chiffres) UNIQUEMENT le temps de créer le compte,
# se connecter, changer le mot de passe, puis SUPPRIMER ces variables.
# ADMIN_PHONE=
# ADMIN_PASSWORD=
